# Auto detect text files and perform LF normalization
* text=auto
crates/tools/tests/golden/** text eol=lf
# テストが include_str! でバイト一致を比べる期待値
crates/tools/src/book_tree/seeds/seeds-original-*  text eol=lf
crates/tools/src/book_tree/add/fixed_rows.tsv text eol=lf

# Rust source files
*.rs text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf

# Batch files (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files
*.bin binary
*.nnue binary

# Lock files
Cargo.lock text eol=lf

# GitHub linguist
*.md linguist-documentation

# 大会公式棋譜のサンプル (CP932 / CRLF)。byte をそのまま保つ。
crates/tools/tests/fixtures/kifu_publish/** -text
