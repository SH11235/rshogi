{
  "name": "rshogi-csa-server-workers",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js dependencies for the Cloudflare Workers frontend (wrangler CLI). Worker source itself is Rust.",
  "type": "module",
  "scripts": {
    "build": "worker-build --release",
    "deploy:staging": "wrangler deploy --config wrangler.staging.toml",
    "deploy:prod": "wrangler deploy --config wrangler.production.toml",
    "tail:staging": "wrangler tail --config wrangler.staging.toml",
    "tail:prod": "wrangler tail --config wrangler.production.toml",
    "dev": "wrangler dev",
    "test:smoke": "vitest run --config tests/miniflare_smoke/vitest.config.ts",
    "test:finalization-exhaustive": "vitest run --config tests/finalization_exhaustive/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@12.9.1"
}
